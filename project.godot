; Godot 4.5 project file. Lets the folder be opened in the Godot editor and
; anchors res:// for the mod's assets (ShopEnhancement/**).
; The mod's .pck is produced by tools/pack_mod.py during `dotnet build`, not by a Godot export.

config_version=5

[application]

config/name="ShopEnhancement"
config/features=PackedStringArray("4.5", "C#")

[dotnet]

project/assembly_name="ShopEnhancement"
