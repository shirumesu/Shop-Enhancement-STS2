<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckGamePath">
  <!--
    Build:    dotnet build -c Release
    Output:   dist/ShopEnhancement/{ShopEnhancement.dll, .pdb, .pck, mod_manifest.json}
    Install:  dotnet build -c Release -p:InstallToGame=true
              (copies the output to <game>/mods/ShopEnhancement; the game prefers a local mod over the
              workshop copy when the local mod_manifest.json version is >= the workshop one)
    Paths:    the game is found through its Steam uninstall registry entry; override with -p:Sts2Dir=...
    BaseLib:  compiled against the NuGet package pinned to the manifest's BaseLib min_version, so the
              build fails if the code uses BaseLib API newer than the version we claim to support.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ShopEnhancement</RootNamespace>
    <AssemblyName>ShopEnhancement</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Logged stack traces show project-relative source paths instead of this machine's absolute ones. -->
    <PathMap>$(MSBuildProjectDirectory)\=.\</PathMap>
    <!-- The game is built for x64 while mods are MSIL. -->
    <NoWarn>$(NoWarn);MSB3270</NoWarn>

    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 2868840', 'InstallLocation', '', RegistryView.Registry64, RegistryView.Registry32))</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <ModDistDir Condition="'$(ModDistDir)' == ''">$(MSBuildProjectDirectory)\dist\ShopEnhancement</ModDistDir>
    <ModInstallDir>$(Sts2Dir)\mods\ShopEnhancement</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="false" />
    <!-- Keep in sync with the BaseLib "min_version" in mod_manifest.json. -->
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="[3.3.5]" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="dist/**;tools/**" />
    <None Remove="dist/**" />
  </ItemGroup>

  <Target Name="CheckGamePath">
    <Error Condition="'$(Sts2Dir)' == '' or !Exists('$(Sts2DataDir)\sts2.dll')"
           Text="Slay the Spire 2 not found (Sts2Dir='$(Sts2Dir)'). Pass -p:Sts2Dir=&lt;game folder&gt;." />
  </Target>

  <Target Name="PackMod" AfterTargets="Build">
    <Exec Command="python -I &quot;$(MSBuildProjectDirectory)\tools\pack_mod.py&quot; --project &quot;$(MSBuildProjectDirectory)&quot; --dll &quot;$(TargetPath)&quot; --out &quot;$(ModDistDir)&quot;" />
  </Target>

  <Target Name="InstallMod" AfterTargets="PackMod" Condition="'$(InstallToGame)' == 'true'">
    <ItemGroup>
      <_ModFiles Include="$(ModDistDir)\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModFiles)" DestinationFolder="$(ModInstallDir)" />
    <Message Importance="high" Text="Installed ShopEnhancement to $(ModInstallDir)" />
  </Target>
</Project>
